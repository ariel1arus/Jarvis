generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Mode {
  CHAT
  REFLECTION
  RESEARCH
  VOICE
  VIDEO
}

enum Role {
  user
  assistant
  system
  tool
}

model ChatSession {
  id           String        @id @default(cuid())
  title        String        @default("New conversation")
  mode         Mode          @default(CHAT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  memoryChunks MemoryChunk[]

  @@index([updatedAt(sort: Desc)])
}

model Message {
  id           String        @id @default(cuid())
  sessionId    String
  session      ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         Role
  content      String
  createdAt    DateTime      @default(now())
  memoryChunks MemoryChunk[]

  @@index([sessionId])
}

enum MemoryKind {
  short_term
  long_term
  episodic
}

enum ActionKind {
  read_only
  local_mutation
  external_side_effect
}

enum AuditStatus {
  pending
  auto_approved
  approved
  rejected
  executed
  failed
}

model MemoryChunk {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  kind      MemoryKind
  content   String      @db.Text
  embedding Unsupported("vector(1536)")
  createdAt DateTime    @default(now())
  expiresAt DateTime?

  @@index([sessionId])
  @@index([kind])
}

// Append-only audit trail for every OpenClaw tool invocation.
// No application-level DELETE is permitted on this table.
model AuditLog {
  id             String      @id @default(cuid())
  sessionId      String?
  toolName       String
  actionKind     ActionKind
  input          Json
  dryRunOutput   Json?
  output         Json?
  status         AuditStatus @default(pending)
  rejectedReason String?
  createdAt      DateTime    @default(now())
  executedAt     DateTime?

  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
}
